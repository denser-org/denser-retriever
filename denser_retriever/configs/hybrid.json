{
  "max_query_len": 2000,
  "es": {
    "url": "${ES_URL:http://localhost:9200}",
    "username": "${ES_USERNAME}",
    "password": "${ES_PASSWORD}"
  },
  "milvus": {
    "uri": "${MILVUS_URI:http://localhost:19530}",
    "user": "${MILVUS_USER}",
    "password": "${MILVUS_PASSWORD}"
  },
  "embedding": {
    "type": "sentence_transformer",
    "model": "Snowflake/snowflake-arctic-embed-m",
    "size": 768,
    "one_model": false
  },
  "combine_config": {
    "method": "hybrid",
    "keyword_top_k":100,
    "vector_top_k":100
  },
  "aggregation": false
}