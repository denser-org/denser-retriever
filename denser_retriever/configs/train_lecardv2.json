{
  "ingest_bs": 20,
  "max_query_size": 0,
  "max_query_len": 2000,
  "max_doc_size": 0,
  "max_doc_len": 8000,
  "es": {
    "url": "${ES_URL:http://localhost:9200}",
    "username": "${ES_USERNAME}",
    "password": "${ES_PASSWORD}"
  },
  "milvus": {
    "uri": "${MILVUS_URI:http://localhost:19530}",
    "user": "${MILVUS_USER}",
    "password": "${MILVUS_PASSWORD}"
  },
  "reranker_model": "BAAI/bge-reranker-base",
  "embedding": {
    "type": "bgem3",
    "model": "BAAI/bge-m3",
    "size": 1024
  },
  "voyage_api_key": "",
  "combine_config": {
    "method": "fusion",
    "keyword_top_k":100,
    "vector_top_k":100,
    "reranker_top_k":100
  },
  "aggregation": false
}
