{
  "max_query_len": 2000,
  "es": {
    "url": "${ES_URL:http://localhost:9200}",
    "username": "${ES_USERNAME}",
    "password": "${ES_PASSWORD}"
  },
  "milvus": {
    "uri": "${MILVUS_URI:http://localhost:19530}",
    "user": "${MILVUS_USER}",
    "password": "${MILVUS_PASSWORD}"
  },
  "reranker_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
  "embedding": {
    "type": "sentence_transformer",
    "model": "Snowflake/snowflake-arctic-embed-m",
    "size": 768,
    "one_model": false
  },
  "combine_config": {
    "method": "fusion",
    "keyword_top_k": 100,
    "vector_top_k": 100,
    "reranker_top_k": 100,
    "lr_config": {
      "lr_features": "es+vs+rr",
      "lr_model": "denser_retriever/models/weights_es+vs+rr_scifact.json"
    }
  },
  "aggregation": false
}
