{
  "max_query_len": 2000,
  "milvus": {
    "uri": "${MILVUS_URI:http://localhost:19530}",
    "user": "${MILVUS_USER}",
    "password": "${MILVUS_PASSWORD}"
  },
  "embedding": {
    "type": "sentence_transformer",
    "model": "Snowflake/snowflake-arctic-embed-m",
    "size": 768,
    "one_model": false
  },
  "combine_config": {
    "method": "vector",
    "vector_top_k":100
  },
  "aggregation": false
}